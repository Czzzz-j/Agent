# Core
API_KEY=replace-me
CORS_ORIGINS=http://localhost:8501,http://localhost:8008

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=furniture_agent
MYSQL_POOL_SIZE=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=5

# Chroma
CHROMA_MODE=auto
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=knowledge_v2
CONVERSATION_MEMORY_COLLECTION=conversation_memory_v1
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_K=20
CHROMA_DATA_PATH=data
CHROMA_ALLOW_TYPES=txt,pdf
CHROMA_CHUNK_SIZE=500
CHROMA_CHUNK_OVERLAP=80
CHROMA_SEPARATORS=\n\n,\n,。！？.,!? ,

# Embedding and reranker
BGE_MODEL_PATH=./models/bge-reranker-base
BGE_ALLOW_DOWNLOAD=
CONVERSATION_EMBEDDING_VERSION=text-embedding-v4

# Memory worker
MEMORY_WORKER_BATCH_SIZE=20
MEMORY_WORKER_POLL_SECONDS=2
MEMORY_WORKER_MAX_RETRIES=8
MEMORY_WORKER_STALE_AFTER_SECONDS=300
MEMORY_WORKER_BACKFILL_ON_START=true

# RAG worker
RAG_WORKER_BATCH_SIZE=20
RAG_WORKER_POLL_SECONDS=2
RAG_WORKER_MAX_RETRIES=8
RAG_WORKER_STALE_AFTER_SECONDS=300
